# Build artifacts
target/
dist/
build/

# IDE
.idea/
*.iml

# Logs
*.log
logs/

# OS files
.DS_Store
.DS_Store?
._*

# Python 运行时生成物（门禁脚本 / 初始化脚本执行后产生，不入库）
__pycache__/
*.py[cod]

# Node (frontend has its own, this is a safeguard)
node_modules/

# 本地环境变量（含数据库口令与 JWT_SECRET，禁止入库；模板：.env.example / scripts/init/env.template）
.env

# 后端本地上传文件（AVATAR_DIR / FILE_STORAGE_DIR 默认相对路径）
uploads/

# ---------------------------------------------------------------
# 部署 / 运维制品不入库（V1.1.0 整改：部署制品移出交付范围，由部署仓库/运维平台托管）
# 历史说明：V1.0.9 已移除 deploy/（Dockerfile、docker-compose、systemd、启停脚本）；
#           V1.1.0 移除 monitoring/（Prometheus 抓取与告警规则、Grafana 看板与数据源配置）。
#           此处规则防止后续误提交同类制品。
# ---------------------------------------------------------------
deploy/
monitoring/
Dockerfile*
docker-compose*.yml
*.service
docker-compose.override.yml
otel-collector-config.yaml
