# =====================================================================================
# java-admin-framework 环境变量模板（env.template）
# -------------------------------------------------------------------------------------
# 用法：
#   1) 复制为仓库根目录的 .env：        cp scripts/init/env.template .env
#   2) 修改必填项（数据库口令、JWT_SECRET）
#   3) 启动前加载：                     set -a && . ./.env && set +a
#   或交由初始化脚本自动生成：          python3 scripts/init/install.py env
#
# 说明：
#   - 所有敏感配置（口令/密钥）均从此文件经环境变量注入，yml 中不硬编码；
#   - local profile 下未设置的变量均有安全默认值；prod profile 缺失即 fail-fast；
#   - JWT_SECRET 必须为 Base64 编码且 ≥256 位（32 字节）。生成命令：
#       openssl rand -base64 32
# =====================================================================================

# ===== 基础 =====
# 激活的 profile：local（本地开发）/ prod（生产）
SPRING_PROFILES_ACTIVE=local

# ===== 主数据库（必填）=====
# JDBC 连接串（库名 scaffold，字符集 utf8mb4）
DB_PRIMARY_URL=jdbc:mysql://localhost:3306/scaffold?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_PRIMARY_USERNAME=root
DB_PRIMARY_PASSWORD=root

# ===== JWT 签名密钥（必填，prod 强制）=====
# 留空或占位时：init 脚本 env 步骤会自动生成 32 字节 Base64 密钥；应用侧则会生成
# 仅当前进程有效的随机临时密钥（重启失效，仅限开发/测试）。
JWT_SECRET=__GENERATE_JWT_SECRET__

# ===== Redis（本地无密码可留空）=====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== 端口（默认值即下列值，一般无需修改）=====
# 应用对外端口（API/Swagger/WebSocket）
SERVER_PORT=8080
# Actuator 独立管理端口（/actuator/health、/actuator/prometheus）
MANAGEMENT_SERVER_PORT=9090
# JobRunr Dashboard（仅 local profile 开启）
JOBRUNR_DASHBOARD_PORT=8000

# ===== WebSocket 跨域允许来源（生产必须收紧为具体前端域名，逗号分隔）=====
WS_ALLOWED_ORIGINS=

# ===== 文件存储目录（生产建议绝对路径）=====
AVATAR_DIR=./uploads/avatar
FILE_STORAGE_DIR=./uploads/file

# ===== 通知渠道（默认关闭；启用后必填对应凭据）=====
# 邮件（app.notifications.email.enabled=true 时生效）
NOTIFICATION_EMAIL_USERNAME=
NOTIFICATION_EMAIL_PASSWORD=
# 短信（app.notifications.sms.enabled=true 且 provider=HTTP 时生效）
NOTIFICATION_SMS_APP_KEY=

# ===== 告警 Webhook 接收端令牌（非空时要求请求头 X-Alert-Token 匹配）=====
ALERT_WEBHOOK_TOKEN=

# ===== 可观测性 =====
# 链路追踪采样率（0~1）
TRACING_SAMPLE_RATE=0.1
# OTLP span 导出端点（observability.otlp.enabled=true 时生效）
OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ===== 外部密钥源（可选：Vault；默认 local）=====
# local = 用上方 JWT_SECRET；vault = 从 Vault KV v2 读取
SECRET_PROVIDER=local
VAULT_ADDR=
VAULT_TOKEN=

# ===== Kafka（可选：启用有序消费模块时配置）=====
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_GROUP_ID=
KAFKA_TOPIC=
KAFKA_ORDERED_CONSUMER_ENABLED=false

