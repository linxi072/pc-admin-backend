<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://acme/scaffold/workflow"
             id="leaveApprovalDefinitions">

    <process id="leaveApproval" name="请假审批（含会签/或签/驳回）" isExecutable="true">

        <startEvent id="startEvent" name="发起"/>

        <!-- 会签/或签节点：多实例并行，审批人来自 assigneeList -->
        <userTask id="countersignTask" name="会签/或签" flowable:assignee="${assignee}">
            <multiInstanceLoopCharacteristics isSequential="false"
                                             flowable:collection="assigneeList"
                                             flowable:elementVariable="assignee">
                <completionCondition>
                    ${rejected == true || nrOfCompletedInstances >= (approvalMode == 'ANY' ? 1 : nrOfInstances)}
                </completionCondition>
            </multiInstanceLoopCharacteristics>
        </userTask>

        <sequenceFlow id="flow_start_cs" sourceRef="startEvent" targetRef="countersignTask"/>

        <exclusiveGateway id="csDecision" name="会签结论"/>

        <sequenceFlow id="flow_cs_reject" sourceRef="countersignTask" targetRef="csDecision"/>
        <sequenceFlow id="flow_cs_to_reject" name="驳回" sourceRef="csDecision" targetRef="rejectedEnd">
            <conditionExpression xsi:type="tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${rejected == true}</conditionExpression>
        </sequenceFlow>

        <!-- 主管审批：单实例 -->
        <userTask id="managerTask" name="主管审批" flowable:assignee="${manager}"/>

        <sequenceFlow id="flow_cs_to_manager" name="通过" sourceRef="csDecision" targetRef="managerTask"/>

        <exclusiveGateway id="managerDecision" name="主管结论"/>

        <sequenceFlow id="flow_mgr_cs" sourceRef="managerTask" targetRef="managerDecision"/>
        <sequenceFlow id="flow_mgr_reject" name="驳回" sourceRef="managerDecision" targetRef="rejectedEnd">
            <conditionExpression xsi:type="tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${managerApproved == false}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flow_mgr_approve" name="通过" sourceRef="managerDecision" targetRef="approvedEnd"/>

        <endEvent id="approvedEnd" name="审批通过"/>
        <endEvent id="rejectedEnd" name="审批驳回"/>
    </process>
</definitions>
