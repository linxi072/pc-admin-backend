<?xml version="1.0" encoding="UTF-8"?>
<!--
  scaffold-system：系统管理与认证授权域（RBAC + 登录 + 系统管理业务）。

  内容：
  - security.*：JWT 签发/轮换、刷新令牌与 Token 版本、密码策略与历史、防重放、
    限流、验证码、数据权限（DataScope）、权限服务、登录服务（AuthService）、
    在线会话、登录日志、安全配置（SecurityConfig）；
  - system.*：用户/角色/菜单/字典/参数/机构/岗位/公告/站内信/文件/短信记录/
    登录日志查询/导入导出业务编排；
  - 握手鉴权适配器 security.jwt.JwtHandshakeAuthenticator（实现 realtime.port 端口）。

  依赖方向：system → {common, realtime}。security 与 system 的相互引用
  （RBAC 实体 + 登录链路）属同一能力域，合并且不构成模块环。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.acme.scaffold</groupId>
        <artifactId>java-admin-framework</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>scaffold-system</artifactId>
    <name>scaffold-system</name>
    <description>系统管理与认证授权：RBAC、JWT/刷新令牌/Token 版本、密码策略、数据权限、用户角色菜单字典等系统业务</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- JWT（自签发令牌） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 邮件通知渠道（EMAIL） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context-support</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.mail</groupId>
            <artifactId>jakarta.mail-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>angus-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme.scaffold</groupId>
            <artifactId>scaffold-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.acme.scaffold</groupId>
            <artifactId>scaffold-realtime</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
</project>
