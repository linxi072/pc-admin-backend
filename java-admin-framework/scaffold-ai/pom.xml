<?xml version="1.0" encoding="UTF-8"?>
<!--
  scaffold-ai：AI 辅助开发集成（ROADMAP R3）。

  内容：ai.port（LlmProvider 端口 + HeuristicLlmProvider 离线默认 / CloudLlmProvider
  条件化可选）/ ai.service（AiScaffoldService 编排 + DdlRenderer 迁移 SQL）/
  ai.controller（AiScaffoldController 走 ai:scaffold:generate 权限码）/
  ai.dto（TableSpec/ColumnSpec/ScaffoldResult/ScaffoldRequest）/ ai.config（AiProperties 成本门禁）。

  依赖方向：ai → {common, codegen}（复用 codegen 的 JavaTypeMapper 与 CodeTemplates.renderAll
  渲染实体/服务/Vue 草稿）。启发式解析确定性、零外部依赖，可过双门禁；云大模型仅条件化可选，
  默认离线构建不激活，避免网络依赖破坏 mvn -o。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.acme.scaffold</groupId>
        <artifactId>java-admin-framework</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>scaffold-ai</artifactId>
    <name>scaffold-ai</name>
    <description>AI 辅助开发集成：自然语言 → 表结构草案 + 迁移 SQL + 代码草稿（需人工复核）</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme.scaffold</groupId>
            <artifactId>scaffold-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.acme.scaffold</groupId>
            <artifactId>scaffold-codegen</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
</project>
