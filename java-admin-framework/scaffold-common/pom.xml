<?xml version="1.0" encoding="UTF-8"?>
<!--
  scaffold-common：全项目公共基础层（零内部模块依赖，被所有模块依赖）。

  内容：
  - common.api / common.error / common.exception：统一响应 Result/PageResult、错误码 ErrorCode、
    业务异常与全局异常处理（GlobalExceptionHandler）；
  - common.i18n / common.validation：多语言消息源与 Bean Validation 校验消息键化；
  - common.context：安全上下文端口（SecurityContextFacade / CurrentPrincipal），
    实现在 scaffold-system（依赖倒置，避免 common → system 成环）；
  - common.web：客户端真实 IP 解析（审计/限流/登录日志共用）；
  - common.audit / common.idempotency：操作审计切面、写接口幂等切面；
  - common.export / common.importer：导出中心（CSV/XLSX）与导入中心；
  - common.sensitive / common.tree / common.id / common.notification：脱敏、树构建、ID 生成、通知抽象；
  - jooq.*：手写动态 DSL（JooqTables / TableRef / JooqSorts）与 Record 映射、分页助手；
  - 资源：i18n 消息束（messages*/validation*）、jOOQ 代码生成输入（db/codegen、jooq-codegen.xml）。

  注意：jOOQ 依赖在本模块声明，其余模块经传递依赖使用（版本由父 POM 统一收敛）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.acme.scaffold</groupId>
        <artifactId>java-admin-framework</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>scaffold-common</artifactId>
    <name>scaffold-common</name>
    <description>公共基础层：统一响应/异常/错误码、i18n、校验、审计、幂等、导出/导入、脱敏、jOOQ 动态 DSL</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jooq</artifactId>
        </dependency>
        <!--
          spring-security-core：GlobalExceptionHandler 需将认证/授权异常
          （AuthenticationException / AccessDeniedException）映射为 401/403 响应，
          幂等记录控制器的 @PreAuthorize 注解亦在此定义。仅引 core（不引入
          starter 的 Web/Config 装配），方法级鉴权启用位于 scaffold-system 的 SecurityConfig。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>
    </dependencies>

    <!--
      jOOQ 代码生成：常驻构建（绑定 generate-sources），每次离线构建自动重生成
      com.acme.scaffold.jooqgen 并行层。DDLDatabase 直接解析 db/codegen/*.sql 反向工程，
      无需连接数据库、无需 Docker。生成物落入 target/generated-sources/jooq（构建产物、
      被 .gitignore 忽略、不纳入版本控制、亦不被 check-conventions 扫描）。

      这是「增量替换手写动态 DSL（JooqTables/TableRef/JooqWriters）」的基础：
      生产代码可逐步引用 com.acme.scaffold.jooqgen.Tables.* 获得类型安全 DSL。
      全量替换仍属高风险改造，按表/服务小范围试点推进（首试点 PostService/sys_post）。

      依赖（jooq-codegen / jooq-meta-extensions / h2 / jaxb 等）已同步进离线仓库，
      故常规 `mvn -o ...` 离线构建即可触发生成；表结构（Flyway 迁移）变更后重新构建即刷新。
    -->
    <build>
        <plugins>
            <!--
              官方代码生成插件（替代原 exec:java 方案，修复 ClassNotFoundException）。
              jooq-codegen-maven 将生成器纳入插件自身 realm，并支持
              <configurationFile> 直接复用 jooq-codegen.xml，classpath 问题天然规避。
            -->
            <plugin>
                <groupId>org.jooq</groupId>
                <artifactId>jooq-codegen-maven</artifactId>
                <version>${jooq.version}</version>
                <!-- DDLDatabase 解析 SQL 反向工程所需：jOOQ meta 扩展 + 内存库（仅生成期） -->
                <dependencies>
                    <dependency>
                        <groupId>org.jooq</groupId>
                        <artifactId>jooq-meta-extensions</artifactId>
                        <version>${jooq.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>com.h2database</groupId>
                        <artifactId>h2</artifactId>
                        <version>2.2.224</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>generate-jooq-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <configurationFile>src/main/resources/jooq-codegen.xml</configurationFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
      在线刷新代码生成器依赖时追加 Maven Central 仓库（离线构建忽略此 profile）。
      常规离线构建依赖已同步进本地仓库，无需激活。
    -->
    <profiles>
        <profile>
            <id>jooq-codegen-online-repo</id>
            <repositories>
                <repository>
                    <id>repo-central</id>
                    <name>Maven Central (codegen)</name>
                    <url>https://repo1.maven.org/maven2</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>repo-central</id>
                    <name>Maven Central (codegen plugins)</name>
                    <url>https://repo1.maven.org/maven2</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>
</project>
