<?xml version="1.0" encoding="UTF-8"?>
<!--
  scaffold-common：全项目公共基础层（零内部模块依赖，被所有模块依赖）。

  内容：
  - common.api / common.error / common.exception：统一响应 Result/PageResult、错误码 ErrorCode、
    业务异常与全局异常处理（GlobalExceptionHandler）；
  - common.i18n / common.validation：多语言消息源与 Bean Validation 校验消息键化；
  - common.context：安全上下文端口（SecurityContextFacade / CurrentPrincipal），
    实现在 scaffold-system（依赖倒置，避免 common → system 成环）；
  - common.web：客户端真实 IP 解析（审计/限流/登录日志共用）；
  - common.audit / common.idempotency：操作审计切面、写接口幂等切面；
  - common.export / common.importer：导出中心（CSV/XLSX）与导入中心；
  - common.sensitive / common.tree / common.id / common.notification：脱敏、树构建、ID 生成、通知抽象；
  - jooq.*：手写动态 DSL（JooqTables / TableRef / JooqSorts）与 Record 映射、分页助手；
  - 资源：i18n 消息束（messages*/validation*）。

  注意：jOOQ 依赖在本模块声明，其余模块经传递依赖使用（版本由父 POM 统一收敛）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.acme.scaffold</groupId>
        <artifactId>java-admin-framework</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>scaffold-common</artifactId>
    <name>scaffold-common</name>
    <description>公共基础层：统一响应/异常/错误码、i18n、校验、审计、幂等、导出/导入、脱敏、jOOQ 动态 DSL</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jooq</artifactId>
        </dependency>
        <!--
          spring-security-core：GlobalExceptionHandler 需将认证/授权异常
          （AuthenticationException / AccessDeniedException）映射为 401/403 响应，
          幂等记录控制器的 @PreAuthorize 注解亦在此定义。仅引 core（不引入
          starter 的 Web/Config 装配），方法级鉴权启用位于 scaffold-system 的 SecurityConfig。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>
    </dependencies>

</project>
