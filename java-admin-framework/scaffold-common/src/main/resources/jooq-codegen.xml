<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  jOOQ 代码生成配置（设计 §15：作为「并行层」探索，不替换手写动态 DSL）。

  重要：本配置生成到独立包 com.acme.scaffold.jooqgen，而非手写 DSL 所在的
  com.acme.scaffold.jooq（JooqTables / TableRef）。二者并存、互不覆盖；
  生产数据访问主线仍为手写动态 DSL。将生成代码全面替换手写 DSL 属高风险改造，
  需真实库验证 + 风险评审，当前暂缓（见需求差距分析文档 A6 / G5a 注记）。

  数据源：Flyway 迁移脚本（src/main/resources/db/migration/V1~V16），
  通过 org.jooq.meta.extensions.ddl.DDLDatabase 直接解析 DDL，
  无需连接数据库、无需 Docker。

  触发方式（需联网拉取 jooq-codegen / jooq-meta-extensions / h2，离线仓库未收录）：
      mvn -Pjooq-codegen generate-sources
  生成结果写入 target/generated-sources/jooq/com/acme/scaffold/jooqgen/
  （标准 Maven 生成源码目录，属构建产物、被 .gitignore 忽略、不纳入版本控制、
   亦不被 check-conventions 扫描）。因此常规离线构建不会引用本生成代码；
  如需刷新生成结果，再次执行上述命令即可。

  表/列/类型与迁移脚本严格一致；新增迁移后再次执行上述命令即可刷新。
-->
<configuration xmlns="http://www.jooq.org/xsd/jooq-codegen-3.19.0.xsd">
    <!-- 无 JDBC：DDLDatabase 直接从 SQL 脚本反向工程，故省略 <jdbc> 元素 -->

    <generator>
        <database>
            <name>org.jooq.meta.extensions.ddl.DDLDatabase</name>
            <properties>
                <property>
                    <key>scripts</key>
                    <!-- 指向归一化后的 H2 兼容 DDL（由 scripts/normalize-ddl-for-codegen.py 从 db/migration 生成）。
                         路径为相对模块 basedir 的相对路径（DDLDatabase 以模块目录为基准解析），支持 ant 通配符；
                         须从模块目录执行 `mvn -Pjooq-codegen generate-sources`（或 `mvn -f scaffold-common/pom.xml` 时
                         路径须相对仓库根），勿用 file:/classpath: 前缀。 -->
                    <value>src/main/resources/db/codegen/*.sql</value>
                </property>
                <!-- 按文件名语义排序（V1 < V2 < ... < V16），保证外键/依赖顺序正确 -->
                <property>
                    <key>sort</key>
                    <value>semantic</value>
                </property>
                <!-- 迁移脚本不带 schema 限定符，统一归入默认 schema -->
                <property>
                    <key>unqualifiedSchema</key>
                    <value>none</value>
                </property>
            </properties>

            <includes>.*</includes>
            <excludes>flyway_schema_history</excludes>
        </database>

        <generate>
            <!-- 实体 / DAO / 查询接口（POJO + Record + DAO + Interface） -->
            <pojos>true</pojos>
            <records>true</records>
            <daos>true</daos>
            <interfaces>true</interfaces>
            <!-- 使用 java.time 类型（LocalDateTime / LocalDate / LocalTime） -->
            <javaTimeTypes>true</javaTimeTypes>
            <!-- Tables.SYS_USER 这类全局静态引用，命名与现有 JooqTables.SYS_USER 对齐 -->
            <globalObjectReferences>true</globalObjectReferences>
            <generatedAnnotation>true</generatedAnnotation>
            <generatedAnnotationType>ORG_JOOQ_GENERATED</generatedAnnotationType>
            <fullyQualifiedTypes>false</fullyQualifiedTypes>
            <!-- 乐观锁/逻辑删除/审计字段由业务层统一处理，生成层不固化 -->
            <springAnnotations>false</springAnnotations>
        </generate>

        <target>
            <packageName>com.acme.scaffold.jooqgen</packageName>
            <!-- 生成进标准 Maven 构建产物目录：不被版本控制、不被 check-conventions 扫描；
                 与手写 DSL（com.acme.scaffold.jooq）并行共存，仅作探索层 -->
            <directory>target/generated-sources/jooq</directory>
        </target>
    </generator>
</configuration>
