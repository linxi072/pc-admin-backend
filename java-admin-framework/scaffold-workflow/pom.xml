<?xml version="1.0" encoding="UTF-8"?>
<!--
  scaffold-workflow：工作流域（Flowable 7.1.0 对接、任务认领/转办、流程设计器）。

  内容：workflow.domain / workflow.entity / workflow.model / workflow.rules /
  workflow.assignee / workflow.bpmn / workflow.adapter / workflow.port /
  workflow.service / workflow.controller / workflow.bootstrap。

  依赖方向：workflow → {common, monitor, realtime, system}。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.acme.scaffold</groupId>
        <artifactId>java-admin-framework</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>scaffold-workflow</artifactId>
    <name>scaffold-workflow</name>
    <description>工作流：Flowable 对接、任务认领/转办/完成、流程设计与部署</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-spring-boot-starter-process</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme.scaffold</groupId>
            <artifactId>scaffold-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.acme.scaffold</groupId>
            <artifactId>scaffold-monitor</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.acme.scaffold</groupId>
            <artifactId>scaffold-realtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.acme.scaffold</groupId>
            <artifactId>scaffold-system</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
</project>
