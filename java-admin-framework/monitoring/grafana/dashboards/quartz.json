{
  "schemaVersion": 39,
  "title": "调度 (Quartz)",
  "uid": "quartz",
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "refresh": "30s",
  "tags": [
    "java-admin-framework"
  ],
  "panels": [
    {
      "type": "stat",
      "title": "失败任务累计",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "quartz_jobs_failed_total",
          "legendFormat": "value"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "近 5m 失败增量",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "increase(quartz_jobs_failed_total[5m])",
          "legendFormat": "failed/5m"
        }
      ]
    },
    {
      "type": "stat",
      "title": "成功任务累计",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "quartz_jobs_succeeded_total",
          "legendFormat": "value"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "注册 / 取消",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "quartz_jobs_scheduled_total",
          "legendFormat": "scheduled"
        },
        {
          "expr": "quartz_jobs_cancelled_total",
          "legendFormat": "cancelled"
        }
      ]
    },
    {
      "type": "text",
      "title": "指标说明",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "options": {
        "mode": "markdown",
        "content": "指标由 `QuartzJobMetrics`（scaffold-job）经 Micrometer 注册，随 actuator 的 `/actuator/prometheus` 暴露，无需额外开关。Quartz 使用 RAMJobStore，不产生 `QRTZ_*` 表；任务执行明细见业务表 `sys_job_log`。应用重启后内置周期任务由 `QuartzConfig` 重新注册。"
      }
    }
  ]
}
