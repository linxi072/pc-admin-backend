{
  "schemaVersion": 39,
  "title": "HikariCP 连接池",
  "uid": "hikaricp",
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "refresh": "30s",
  "tags": [
    "java-admin-framework"
  ],
  "panels": [
    {
      "type": "stat",
      "title": "连接池使用率 (%)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(hikaricp_connections_active) / sum(hikaricp_connections_max) * 100",
          "legendFormat": "value"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "type": "timeseries",
      "title": "活跃 / 空闲 / 等待",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active",
          "legendFormat": "active"
        },
        {
          "expr": "hikaricp_connections_idle",
          "legendFormat": "idle"
        },
        {
          "expr": "hikaricp_connections_pending",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "连接获取耗时 (s)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "hikaricp_connections_acquire_seconds",
          "legendFormat": "acquire"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "创建连接耗时 (s)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "hikaricp_connections_creation_seconds",
          "legendFormat": "creation"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    }
  ]
}