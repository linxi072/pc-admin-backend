<?xml version="1.0" encoding="UTF-8"?>
<!--
  scaffold-codegen：代码生成器（按表结构生成 CRUD 骨架代码）。

  内容：codegen.service（模板渲染）、codegen.config、codegen.controller、codegen.dto。

  依赖方向：codegen → common only（模板与表元数据均来自 common 的 jOOQ DSL）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.acme.scaffold</groupId>
        <artifactId>java-admin-framework</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>scaffold-codegen</artifactId>
    <name>scaffold-codegen</name>
    <description>代码生成器：表元数据读取与 CRUD 骨架代码生成</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme.scaffold</groupId>
            <artifactId>scaffold-common</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
</project>
