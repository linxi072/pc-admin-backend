<?xml version="1.0" encoding="UTF-8"?>
<!--
  scaffold-realtime：实时推送通道（原生 WebSocket，站内信/待办实时推送）。

  内容：realtime.websocket（握手拦截器 + 处理器 + Origin 策略）、realtime.session
  （会话管理）、realtime.service（推送服务）、realtime.controller、realtime.payload、
  realtime.port（握手令牌鉴权端口，由 scaffold-system 的 security.jwt 适配器实现）。

  依赖方向：realtime → common  only。不依赖 security/system——
  握手鉴权经 realtime.port 端口倒置，避免与 system 模块成环。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.acme.scaffold</groupId>
        <artifactId>java-admin-framework</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>scaffold-realtime</artifactId>
    <name>scaffold-realtime</name>
    <description>实时推送通道：原生 WebSocket 握手鉴权端口、会话管理、定向推送</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>com.acme.scaffold</groupId>
            <artifactId>scaffold-common</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
</project>
