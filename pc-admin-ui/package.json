  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/server-renderer": "^3.4.38",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.4",
    "vite": "^5.4.8",
    "vitest": "^2.1.9",
    "vue": "^3.4.38"
  }
