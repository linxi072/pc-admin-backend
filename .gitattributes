# 统一换行符：所有文本文件以 LF 入库与检出，防御 Windows 环境 CRLF 污染
* text=auto eol=lf

# 明确文本类型（确保跨平台一致）
*.java text eol=lf
*.vue text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.py text eol=lf
*.editorconfig text eol=lf
*.gitattributes text eol=lf

# 二进制资源不转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
